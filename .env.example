# =============================================================================
# ai-saas-template（AI SaaS 母模板）—— 环境变量模板
# =============================================================================
# 复制为 `.env.local` 后填入真实值：
#     cp .env.example .env.local
#
# **切勿把真实密钥提交到仓库。**
#
# 分组：
#   [CORE]      运行必需（数据库 / 认证 / AI Provider）
#   [STORAGE]   对象存储（可选；未配置时生成结果只保留 Provider 原始 URL）
#   [BILLING]   支付渠道（至少配置一个）
#   [PRODUCT]   产品 / 品牌信息（换产品时只改这一段）
#   [OPTIONAL]  人机验证 / 内容安全 / 分析 / 调试
#
# 校验：`node scripts/audit-env.mjs`（检查本文件与代码使用是否一致）
# =============================================================================

# ── [CORE] Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role key：仅服务端使用，**绝不可**暴露给客户端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 可选：直连 Postgres（迁移 / 脚本 / 排错用）
# ⚠️ 应用运行时【完全不读】这个变量（src/ 与 scripts/ 下 0 处引用）。
#    数据访问一律走 Supabase：NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY。
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── [CORE] NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET=
# 可选：Cookie 域名（多子域部署时设置）
# NEXTAUTH_COOKIE_DOMAIN=.your-domain.com

# ── [CORE] OAuth（可选，按需启用）─────────────────────────────────────────────
NEXT_PUBLIC_AUTH_CREDENTIALS_ENABLED=true
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
GOOGLE_ID=
GOOGLE_SECRET=
# 可选：Google One Tap（组件 GoogleOneTap.tsx 使用；不填则不显示）
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── [CORE] Admin ─────────────────────────────────────────────────────────────
# bootstrap 白名单：命中即把该账号的 users.role 写为 admin（之后只看 role）
# ADMIN_EMAILS=admin@your-domain.com

# ── [CORE] AI Provider ───────────────────────────────────────────────────────
# 默认渠道：fal | kie | wavespeed | atlascloud
AI_PROVIDER=fal
IMAGE_GENERATION_PROVIDER=fal

# fal（走官方 SDK，base URL 不可配）
FAL_KEY=

# kie（base URL 可配，便于指向 mock）
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_WEBHOOK_SIGNING_SECRET=

# atlascloud
ATLASCLOUD_API_KEY=
ATLASCLOUD_API_BASE_URL=https://api.atlascloud.ai

# wavespeed
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai
WAVESPEED_WEBHOOK_SECRET=

# 可选：异步任务轮询调参（毫秒；不填用各 Provider 内置默认）
# KIE_POLL_INTERVAL_MS=5000
# KIE_POLL_TIMEOUT_MS=300000
# ATLASCLOUD_POLL_INTERVAL_MS=5000
# ATLASCLOUD_POLL_TIMEOUT_MS=300000
# WAVESPEED_POLL_INTERVAL_MS=5000
# WAVESPEED_POLL_TIMEOUT_MS=300000

# ── [STORAGE] 对象存储（可选）────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 公开访问 URL（用于拼接最终资源地址）
R2_PUBLIC_URL=

# ── [BILLING] 支付渠道（至少配置一个）─────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_PAYMENT_PROVIDER=creem
# 未完成支付时的返回地址（不填则用 {站点}/pricing）
# NEXT_PUBLIC_PAY_CANCEL_URL=

# Stripe（服务端金额动态定价）
NEXT_PUBLIC_ENABLE_STRIPE=false
STRIPE_PRIVATE_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Creem（金额由 Creem 后台产品决定，本仓库传过去的 amount 仅作元数据）
# ⚠️ NEXT_PUBLIC_ENABLE_CREEM 目前【没有任何代码读取】——它原本服务于已退役的
#    `npm run check`（Phase 9.6 删除）。Creem 是否启用只取决于下面两个变量是否配齐
#    （见 CreemProvider.isConfigured()）。保留本变量仅为避免既有部署配置报错。
NEXT_PUBLIC_ENABLE_CREEM=false
CREEM_API_KEY=
CREEM_API_URL=https://api.creem.io
CREEM_WEBHOOK_SECRET=

# ── [PRODUCT] 产品 / 品牌（换产品时只改这一段）──────────────────────────────────
# 产品名：用于 Logo / SEO / PWA 等。**每个产品都应该改成自己的品牌名**；
# 不填时母版回落到母版本身的名字 `ai-saas-template`（见 src/lib/site-config.ts）。
NEXT_PUBLIC_PROJECT_NAME=ai-saas-template
# 站点公开地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# 可选：API / CDN 子域（不填则从站点地址派生）
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
# NEXT_PUBLIC_CDN_URL=https://cdn.your-domain.com
# 支持邮箱（不填则从站点域名派生 support@…）
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# 社交 / 仓库链接
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-org/your-repo
# NEXT_PUBLIC_X_URL=https://x.com/your-brand
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-brand
# NEXT_PUBLIC_PINTEREST_URL=https://pinterest.com/your-brand
# Twitter/X 句柄（用于 twitter:creator / twitter:site，留空则省略）
# NEXT_PUBLIC_TWITTER_HANDLE=@your-brand
# 演示视频 CDN 域名（next.config.js 的 remotePatterns 用；不填用内置默认）
# NEXT_PUBLIC_DEMO_VIDEOS_URL=

# ── [OPTIONAL] 人机验证 ──────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── [OPTIONAL] 内容安全 ──────────────────────────────────────────────────────
# 启用后：prompt / 生成结果会经过安全检查（见 lib/content-safety/safe-mode.ts）
NEXT_PUBLIC_ENABLE_CONTENT_SAFETY=false
# 可选：OpenAI 内容审核（不配置则用内置规则）
# OPENAI_API_KEY=

# ── [OPTIONAL] 分析 / 站长验证 ────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
# NEXT_PUBLIC_CUSTOM_ANALYTICS_URL=
# NEXT_PUBLIC_CUSTOM_ANALYTICS_DOMAIN=

# ── [OPTIONAL] 调试 ──────────────────────────────────────────────────────────
# 详细日志（仅非生产环境生效）
ENABLE_VERBOSE_LOGS=false
# 放开 /api/debug/* 路由（仅非生产环境；默认关闭）
ENABLE_DEBUG_ROUTES=false

# ── [OPTIONAL] HTTP 冒烟测试（scripts/smoke-ai-core.mjs）───────────────────────
# SMOKE_BASE_URL=http://localhost:3000
# SMOKE_SECTION=contract        # contract | billing | e2e
# SMOKE_TARGET=
# SMOKE_MODEL=flux-kontext-pro
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
# SMOKE_MAX_RETRIES=3
# SMOKE_RATE_WAIT_MS=5000
