{
  "name": "ai-saas-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:turbo": "next dev -H 0.0.0.0 --turbopack --port 3000",
    "dev:stable": "next dev --port 3000",
    "dev:clean": "node scripts/kill-ports.js 3000-3010 && next dev --port 3000",
    "kill:ports": "node scripts/kill-ports.js 3000-3010",
    "kill:3000": "node scripts/kill-ports.js 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "verify": "node scripts/verify-all.mjs",
    "ci": "npm run verify",
    "verify:fast": "node scripts/verify-all.mjs --skip-build --skip-migrations",
    "verify:product-boundary": "node scripts/verify-product-boundary.mjs",
    "verify:product-seam": "node scripts/verify-product-seam.mjs",
    "audit:dead-files": "node scripts/audit-dead-files.mjs",
    "audit:unused-exports": "node scripts/audit-unused-exports.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:env": "node scripts/audit-env.mjs",
    "migrations:static": "node scripts/verify-all.mjs --only=migrations:static",
    "migrations:real": "node scripts/verify-all.mjs --only=migrations:real",
    "smoke:ai": "node scripts/smoke-ai-core.mjs",
    "check:image": "node scripts/check-image-optimization.js",
    "format": "npx @biomejs/biome format --write .",
    "setup:env": "cp .env.example .env.local && npm run audit:env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "@fal-ai/client": "^1.5.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.14.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^0.475.0",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.4",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "uuid": "$uuid"
  }
}
